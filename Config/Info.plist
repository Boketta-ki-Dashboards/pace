<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PaceSupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>PaceSupabasePublishableKey</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<key>PaceGIPHYAPIKey</key>
	<string>$(GIPHY_API_KEY)</string>
	<key>PaceSupportEmail</key>
	<string>$(PACE_SUPPORT_EMAIL)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
		<string>ru</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>app.pace.profile-link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pace</string>
			</array>
		</dict>
	</array>
	<key>NSMotionUsageDescription</key>
	<string>Pace nutzt den Bewegungssensor, damit deine Schrittzahl beim Gehen sofort mitzählt, solange Pace geöffnet ist. Gespeichert und für Rankings verwendet werden weiterhin nur die Schritte aus Apple Health.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Pace braucht das Mikrofon nur, während du eine Sprachnachricht für einen Chat aufnimmst.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
</dict>
</plist>
