// Pace – gemeinsame Build-Einstellungen für alle Konfigurationen (Debug und Release).
//
// Lokale Werte (Supabase) stehen in Config/Pace.xcconfig. Diese Datei steht in .gitignore und wird nie
// committet. Vorlage: Config/Pace.xcconfig.example.
//
// Fehlt Config/Pace.xcconfig, bleiben die Werte leer: Die App baut trotzdem (z. B. in der CI) und zeigt beim
// Start einen Hinweis, dass das Backend nicht konfiguriert ist.

SUPABASE_URL =
SUPABASE_PUBLISHABLE_KEY =

// Optional: GIF-Suche im Chat über GIPHY (developers.giphy.com). Leer = keine GIF-Suche; die App sagt das ehrlich.
// Der Schlüssel gehört wie die Supabase-Werte nur in Config/Pace.xcconfig.
GIPHY_API_KEY =

// Alternative App-Icons für Profil → Darstellung → App-Icon („Hell“ und „Dunkel“). Das primäre Icon „AppIcon“
// (Einstellung „Automatisch“) steht in den Target-Einstellungen. Bewusst hier und nicht in project.pbxproj, damit
// lokale Signing-Einstellungen im Projekt beim Aktualisieren nicht kollidieren.
ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES = AppIconLight AppIconDark

// Optionaler Include: kein Fehler, wenn die Datei fehlt.
#include? "Pace.xcconfig"
